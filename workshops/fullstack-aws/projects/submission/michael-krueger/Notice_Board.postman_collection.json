{
  "info": {
    "name": "Notice Board",
    "description": "Endpoint tests for the Notice Board backend: auth (signup/login) and GET/POST/DELETE /notices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8001" },
    { "key": "test_username", "value": "postman_tester" },
    { "key": "test_password", "value": "TestPassword123!" },
    { "key": "access_token", "value": "" },
    { "key": "last_notice_id", "value": "" },
    { "key": "other_access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Status field is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
      ]}}]
    },
    {
      "name": "Auth - Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/signup",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "// 201 on first run. Re-running without changing test_username will",
        "// 400/409 on duplicate, which is expected, not a failure of the app.",
        "pm.test('Status is 201 (or 400/409 if user already exists)', function () {",
        "    pm.expect([201, 400, 409]).to.include(pm.response.code);",
        "});"
      ]}}]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Response has an access_token', function () {",
        "    pm.expect(pm.response.json()).to.have.property('access_token');",
        "});",
        "// Capture the token so every protected request below can use it automatically.",
        "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
      ]}}]
    },
    {
      "name": "Auth - Login with Wrong Password (expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"WrongPassword\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 401 for bad credentials', function () { pm.response.to.have.status(401); });"
      ]}}]
    },
    {
      "name": "List Notices (GET, public, no token needed)",
      "request": { "method": "GET", "url": "{{base_url}}/notices" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
      ]}}]
    },
    {
      "name": "Create Notice Without Token (expect 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/notices",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Michael\",\n  \"message\": \"Should be rejected\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 401 without a token', function () { pm.response.to.have.status(401); });"
      ]}}]
    },
    {
      "name": "Create Notice (POST, authenticated)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/notices",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Michael\",\n  \"message\": \"Testing via Postman\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
        "pm.test('Response has id, user_id, and created_at', function () {",
        "    const body = pm.response.json();",
        "    pm.expect(body).to.have.property('id');",
        "    pm.expect(body).to.have.property('user_id');",
        "    pm.expect(body).to.have.property('created_at');",
        "});",
        "pm.collectionVariables.set('last_notice_id', pm.response.json().id);"
      ]}}]
    },
    {
      "name": "Create Notice - Missing Fields (POST, expect 422)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/notices",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"message\": \"\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 422 for blank fields', function () { pm.response.to.have.status(422); });"
      ]}}]
    },
    {
      "name": "Delete Notice Without Token (expect 401)",
      "request": { "method": "DELETE", "url": "{{base_url}}/notices/{{last_notice_id}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 401 without a token', function () { pm.response.to.have.status(401); });"
      ]}}]
    },
    {
      "name": "Auth - Signup Second User (for ownership test)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/signup",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"postman_tester_2\",\n  \"password\": \"{{test_password}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 201 (or 400/409 if user already exists)', function () {",
        "    pm.expect([201, 400, 409]).to.include(pm.response.code);",
        "});"
      ]}}]
    },
    {
      "name": "Auth - Login Second User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"postman_tester_2\",\n  \"password\": \"{{test_password}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.collectionVariables.set('other_access_token', pm.response.json().access_token);"
      ]}}]
    },
    {
      "name": "Delete Someone Else's Notice (expect 403)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{other_access_token}}" }],
        "url": "{{base_url}}/notices/{{last_notice_id}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "// last_notice_id belongs to test_username, this request authenticates",
        "// as postman_tester_2, so it must be rejected.",
        "pm.test('Status is 403 when deleting a notice you do not own', function () {",
        "    pm.response.to.have.status(403);",
        "});"
      ]}}]
    },
    {
      "name": "Delete Own Notice (DELETE, expect 204)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/notices/{{last_notice_id}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
      ]}}]
    },
    {
      "name": "Delete Own Notice Again (DELETE, expect 404)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "{{base_url}}/notices/{{last_notice_id}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 404 on repeat delete', function () { pm.response.to.have.status(404); });"
      ]}}]
    }
  ]
}
