# Template for the .env file, safe to commit because it holds no secret.
# Copy it and adjust if your backend runs somewhere else:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS and Linux)

# Where the FastAPI backend is listening.
#
# The VITE_ prefix is required. Vite refuses to expose any variable without
# it to the browser, which is a safety feature: it means a stray secret in
# this file cannot end up in the bundle by accident.
#
# Note that this value is inlined at build time, not read when the page
# loads. Changing it needs a restart of the dev server to take effect, and a
# production build bakes in whatever was set when it was built.
#
# No trailing slash needed. One is stripped in src/api/notices.js either way.
VITE_API_URL=http://localhost:8001
