# Template for the .env file. Safe to commit because it holds no real key.
# Copy it and fill in your own values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS and Linux)
#
# .env itself is ignored by git. Keep it that way.

# Your Supabase project URL.
# Dashboard, Project Settings, API, "Project URL".
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The API key the backend authenticates with.
# Dashboard, Project Settings, API, "Project API keys".
#
# Use the "service_role" key.
#
# This is a change from the anon key used before authentication existed, and
# it is a deliberate trade. service_role bypasses row level security
# entirely, so the policies in schema.sql no longer protect anything: the
# backend can read and write every row in every table.
#
# That is what makes the JWT checks in app/dependencies.py and the ownership
# check in app/services/notice_service.py the only thing standing between a
# caller and the data. With the anon key, a bug in those checks would still
# have run into an RLS policy. Now it will not.
#
# It must never reach the frontend, a commit, or a log. Anyone holding it has
# full access to the database, with no policy in the way.
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# The key every access token is signed with.
#
# Anyone who has this can mint a token for any user, so it must never be
# committed and each environment should use its own. Changing it invalidates
# every token already issued, which is the closest thing this app has to
# logging everybody out.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=YOUR_GENERATED_SECRET_HERE
