# Connection string for the PostgreSQL database, in the format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
# Copy this file to .env and fill in your real values — .env itself is
# git-ignored so credentials never get committed.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>


# Secret key used to sign/verify JWT login tokens. Use a long random string —
# anyone with this value could forge a valid login token.
JWT_SECRET_KEY=<your-random-secret-key>