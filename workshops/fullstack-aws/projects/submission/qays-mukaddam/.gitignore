# Real secrets/DB credentials — never commit this, only .env.example
.env

# Python's compiled bytecode cache, auto-regenerated, no reason to track it
__pycache__/

# Individual compiled Python files (same reason as __pycache__/)
*.pyc

# Local Python virtual environment folder — huge, and different per machine
venv/

# Installed npm packages for the frontend — huge, regenerated from package.json
node_modules/

# The frontend's built/production output — regenerated by "npm run build"
dist/