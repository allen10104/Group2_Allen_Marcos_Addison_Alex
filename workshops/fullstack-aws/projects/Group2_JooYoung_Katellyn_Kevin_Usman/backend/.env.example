# Copy to backend/.env for local dev (already gitignored).
# In production this same file is written by Terraform's user_data on the EC2 instance.

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=noticeboard
PG_USER=noticeboard_app
PG_PASSWORD=localdev

# Leave blank for local dev — uploads fall back to backend/_local_uploads/
# and are served at /uploads/* directly by the FastAPI app. Set in production
# to write/read images from S3 instead (served via CloudFront's /uploads/*).
S3_UPLOADS_BUCKET=
AWS_REGION=us-east-1

# Comma-separated allowed origins, or * for any (fine for local dev; in
# production the frontend and API share the CloudFront origin anyway).
CORS_ORIGINS=*
