# Copy to .env for local dev: cp .env.example .env
# Points the frontend at the API. Note the /api suffix — the backend's
# routes are mounted under /api/*, which is also the path pattern
# CloudFront routes to the EC2 backend in production.
#
# Local dev:  VITE_API_URL=http://localhost:8000/api
# Production: VITE_API_URL=https://<cloudfront-domain>/api
VITE_API_URL=http://localhost:8000/api
